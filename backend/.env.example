# Authentication Mode: 'development' or 'cognito'
AUTH_MODE=development

# Dev JWT Secret
JWT_SECRET_KEY=your_dev_jwt_secret_key_here
JWT_ALGORITHM=HS256

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5433/capitalmind

# AWS Cognito Parameters (used when AUTH_MODE=cognito)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Market Data Configuration ('mock' or 'real')
MARKET_DATA_MODE=mock
MARKET_DATA_API_KEY=your_market_data_api_key_here
MARKET_DATA_PROVIDER_URL=https://api.marketprovider.example.com

# Upstox Analytics Token Configuration
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_MARKET_DATA_ENABLED=false
UPSTOX_MARKET_DATA_MODE=mock

# Google Gemini AI Market Impact Analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_ANALYSIS_ENABLED=true

# Financial News Ingestion
NEWS_INGESTION_ENABLED=true
NEWS_INGESTION_INTERVAL_MINUTES=15
NEWS_MAX_ANALYSES_PER_RUN=5
